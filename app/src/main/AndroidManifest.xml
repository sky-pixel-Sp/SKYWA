<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <application
      android:label="SKYWA Bot Studio"
      android:theme="@style/Theme.Skywa"
      android:allowBackup="false"
      android:icon="@drawable/skywa_logo"
      android:usesCleartextTraffic="true">
    <activity
        android:name="com.skywa.ui.AISettingsActivity"
        android:exported="false" />
    <activity
        android:name="com.skywa.ui.MainActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|keyboardHidden">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>

    <service
        android:name="com.skywa.runtime.NodeService"
        android:process=":node_runtime"
        android:exported="false"
        android:foregroundServiceType="specialUse"
        android:stopWithTask="false">
      <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Maintain the user-enabled local SKYWA WhatsApp automation runtime and handle incoming messages."/>
    </service>
  </application>
</manifest>
